[Unit]
Description=FoodFlow host receipt OCR bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/foodflow
Environment=FOODFLOW_OCR_PORT=4331
Environment=FOODFLOW_OCR_HOST=10.255.0.1
ExecStart=/usr/bin/node /opt/foodflow/server/local-ocr-host.mjs
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
