FOODFLOW_API_PORT=4320
FOODFLOW_HOST_PORT=4320
# Optional: an authorized provider that can read the Douyin source and return recipe fields.
DOUYIN_PROVIDER_URL=
DOUYIN_PROVIDER_TOKEN=
FOODFLOW_DB_PATH=/data/foodflow.sqlite
# Optional receipt OCR provider. It receives JSON: imageBase64, mimeType, locale.
RECEIPT_OCR_PROVIDER_URL=
RECEIPT_OCR_PROVIDER_TOKEN=
RECEIPT_OCR_TIMEOUT_MS=15000
# Optional host-level OCR bridge; the VPS setup can point this to local Tesseract.
FOODFLOW_LOCAL_OCR_URL=http://host.docker.internal:4331/ocr
